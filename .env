# Rename this file to .env and fill in your values

# Your bot's token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your bot's Application (Client) ID
CLIENT_ID=

# Optional: put your server ID here while testing so slash commands
# register instantly in that one server instead of taking up to 1hr globally.
# Leave blank to deploy commands globally to every server the bot is in.
GUILD_ID=
